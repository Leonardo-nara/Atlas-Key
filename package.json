{
  "name": "delivery-platform-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @deliveries/backend --filter @deliveries/desktop --filter @deliveries/mobile run dev",
    "dev:backend": "pnpm --filter @deliveries/backend dev",
    "dev:desktop": "pnpm --filter @deliveries/desktop dev",
    "dev:mobile": "pnpm --filter @deliveries/mobile dev",
    "seed:demo": "pnpm --filter @deliveries/backend prisma:seed",
    "build:backend": "pnpm --filter @deliveries/backend build",
    "build:desktop": "pnpm --filter @deliveries/desktop build",
    "build:desktop:win": "pnpm --filter @deliveries/desktop dist:win",
    "build:mobile": "pnpm --filter @deliveries/mobile build",
    "build:mobile:android:preview": "pnpm --filter @deliveries/mobile build:android:preview",
    "build:mobile:android:production": "pnpm --filter @deliveries/mobile build:android:production",
    "build": "pnpm -r --filter ./packages/** --filter ./apps/** run build",
    "lint": "pnpm -r --filter ./packages/** --filter ./apps/** run lint",
    "typecheck": "pnpm -r --filter ./packages/** --filter ./apps/** run typecheck",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/node": "^22.14.0",
    "@types/react": "~19.0.10",
    "@types/react-dom": "~19.0.4",
    "eslint": "^9.23.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.28.0"
  },
  "pnpm": {
    "overrides": {
      "@expo/config-plugins": "10.1.2",
      "@expo/prebuild-config": "9.0.12",
      "@react-native-community/cli": "18.0.1",
      "@react-native-community/cli-clean": "18.0.1",
      "@react-native-community/cli-config": "18.0.1",
      "@react-native-community/cli-config-android": "18.0.1",
      "@react-native-community/cli-config-apple": "18.0.1",
      "@react-native-community/cli-doctor": "18.0.1",
      "@react-native-community/cli-platform-android": "18.0.1",
      "@react-native-community/cli-platform-apple": "18.0.1",
      "@react-native-community/cli-platform-ios": "18.0.1",
      "@react-native-community/cli-server-api": "18.0.1",
      "@react-native-community/cli-tools": "18.0.1",
      "@xmldom/xmldom": "0.8.13",
      "defu": "6.1.7",
      "effect": "3.22.0",
      "fast-xml-builder": "1.3.0",
      "shell-quote": "1.8.4",
      "undici": "6.27.0",
      "ws": "8.21.1"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "electron",
      "esbuild",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
