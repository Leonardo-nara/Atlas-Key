{
  "cli": {
    "version": ">= 16.17.2"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://rotapronta-api-production.up.railway.app/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://rotapronta-api-production.up.railway.app"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "qa": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://rotapronta-api-sandbox-production.up.railway.app/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://rotapronta-api-sandbox-production.up.railway.app"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://rotapronta-api-production.up.railway.app/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://rotapronta-api-production.up.railway.app"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
