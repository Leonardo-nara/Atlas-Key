{
  "expo": {
    "name": "Mototake",
    "slug": "delivery-platform-courier",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "mototake",
    "android": {
      "package": "com.souzaworks.mototake",
      "versionCode": 2,
      "allowBackup": false,
      "permissions": []
    },
    "ios": {
      "bundleIdentifier": "com.souzaworks.mototake",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Permita acesso a fotos para anexar imagens e comprovantes quando voce escolher enviar um arquivo.",
        "NSCameraUsageDescription": "Permita acesso a camera para capturar imagens e comprovantes quando voce escolher tirar uma foto."
      }
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "6ebb569d-12af-4f00-8e5d-6b64a668c661"
      }
    },
    "owner": "souzanara"
  }
}
