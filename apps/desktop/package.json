{
  "name": "@deliveries/desktop",
  "version": "1.0.1",
  "private": true,
  "productName": "Mototake",
  "description": "Painel desktop Mototake para operacao de pedidos, PDV, caixa e estoque.",
  "author": "Mototake",
  "main": "dist-electron/electron/main.js",
  "files": [
    "dist",
    "dist-electron",
    "package.json"
  ],
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:renderer\" \"pnpm dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "build": "pnpm build:renderer && pnpm build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dist": "pnpm build && electron-builder",
    "dist:win": "pnpm build && electron-builder --win nsis --publish never",
    "test:updater": "pnpm build:electron && node --test tests/updater.test.cjs",
    "dist:dir": "pnpm build && electron-builder --dir",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"electron/**/*.ts\" vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "clean": "if exist dist rmdir /s /q dist & if exist dist-electron rmdir /s /q dist-electron"
  },
  "dependencies": {
    "@deliveries/shared-types": "workspace:*",
    "electron-updater": "6.8.9",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "^7.18.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.mototake.desktop",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist-electron",
        "to": "dist-electron",
        "filter": [
          "**/*"
        ]
      },
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/electron/main.js"
    },
    "publish": {
      "provider": "github",
      "owner": "Leonardo-nara",
      "repo": "Atlas-Key",
      "tagNamePrefix": "desktop-v",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Mototake-Setup-${version}.${ext}"
    }
  }
}
